# AI VisionLab environment configuration
HOST=0.0.0.0
PORT=5000

FLASK_ENV=production
FLASK_DEBUG=false

# Generate using: openssl rand -hex 32
STAGE1_SECRET_KEY=

# Maximum dataset upload size
MAX_UPLOAD_MB=2048

# ZIP extraction security limits
MAX_EXTRACT_FILES=10000
MAX_EXTRACT_BYTES=1073741824
MAX_EXTRACT_RATIO=100

# Optional persistent data directory
# DATA_DIR=/app/webapp_data
